{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memohai-supermarket-writer",
  "main": "./writer/src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "SKILL_REGISTRY_BUCKET",
      "bucket_name": "test-memoh-supermarket"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "containers": [
    {
      "class_name": "RegistryWriter",
      "image": "./writer.Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY_WRITER",
        "class_name": "RegistryWriter"
      },
      {
        "name": "REGISTRY_COORDINATOR",
        "class_name": "RegistryCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RegistryWriter", "RegistryCoordinator"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
