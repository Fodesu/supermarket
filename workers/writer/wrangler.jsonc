{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "memohai-supermarket-writer-local",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RegistryWriter"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "test": {
      "name": "memohai-supermarket-writer-test",
      "workers_dev": true,
      "containers": [
        {
          "name": "memohai-supermarket-writer-container-test",
          "class_name": "RegistryWriter",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "max_instances": 1
        }
      ],
      "r2_buckets": [
        {
          "binding": "SKILL_REGISTRY_BUCKET",
          "bucket_name": "test-memoh-supermarket"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY_WRITER",
            "class_name": "RegistryWriter"
          }
        ]
      }
    },
    "production": {
      "name": "memohai-supermarket-writer",
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "containers": [
        {
          "name": "memohai-supermarket-writer-container-production",
          "class_name": "RegistryWriter",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "max_instances": 1
        }
      ],
      "r2_buckets": [
        {
          "binding": "SKILL_REGISTRY_BUCKET",
          "bucket_name": "memoh-supermarket"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRY_WRITER",
            "class_name": "RegistryWriter"
          }
        ]
      }
    }
  }
}
